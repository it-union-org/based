# based bot - пример переменных окружения
# Скопируй в .env и заполни своими значениями.
# ВАЖНО: .env не коммитится в git.

# Токен бота MAX (обязательно)
BOT_TOKEN=

# Адрес Ollama. Для docker-compose оставь http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# URL архива с ассетами (промпты и тестовые данные)
ASSETS_BASE_URL=https://github.com/it-union-org/assets/releases/download
ASSETS_VERSION=v1.0.0

# Каталоги кеша
BOT_CACHE_DIR=~/.cache/based-bot
BASED_CACHE_DIR=~/.cache/based

# Ограничение по пользователям (пусто = все)
BOT_ALLOWED_USER_IDS=
